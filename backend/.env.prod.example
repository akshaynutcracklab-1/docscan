# Copy to .env.prod on the server and fill in. Never commit .env.prod.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod && nano .env.prod

# Public domain pointing at the server's IP (e.g. a free duckdns.org subdomain).
DOMAIN=docscan-api.duckdns.org

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# localhost is needed for the container's internal health check.
ALLOWED_HOSTS=docscan-api.duckdns.org,localhost
CSRF_TRUSTED_ORIGINS=https://docscan-api.duckdns.org
# Only needed if a browser front end on another domain calls the API (the mobile app doesn't need it).
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Postgres (used by the db container and by Django). Use the same password in both places.
POSTGRES_DB=docscan
POSTGRES_USER=docscan
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://docscan:change-me-long-random@db:5432/docscan

# Azure Document Intelligence (copy from your local .env).
OCR_ENGINE=azure
DOCINTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
DOCINTEL_KEY=
DOCINTEL_TIER=F0

# Tuning for a 2-4 OCPU ARM VM.
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2
